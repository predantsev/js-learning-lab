{
  "name": "js-learning-lab-expenses",
  "version": "1.0.0",
  "private": true,
  "description": "%%projectTitle%% — exported from js learning lab",
  "type": "module",
  "scripts": {
    "start": "npm run build && npm run build:tests && node --env-file=.env serve.mjs",
    "lint": "eslint .",
    "format": "prettier --write main.tsx ui",
    "build": "esbuild main.tsx --bundle --splitting --sourcemap --format=esm --outdir=dist --entry-names=app",
    "test": "node run-tests.js",
    "typecheck": "tsc -p .",
    "build:tests": "esbuild tests/ui-run.tsx --bundle --sourcemap --format=esm --outfile=dist/tests.js",
    "release": "node scripts/release.mjs",
    "preview": "node --env-file=.env scripts/preview.mjs",
    "ci": "npm run lint && npm run typecheck && npm test && node scripts/release.mjs ci"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
