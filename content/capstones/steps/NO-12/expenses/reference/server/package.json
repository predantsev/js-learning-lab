{
  "name": "js-learning-lab-expenses-server",
  "version": "1.0.0",
  "private": true,
  "description": "The Node.js part of the expenses: the records server and its scripts",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test tests/*.test.ts",
    "summary": "node src/summary.ts",
    "add": "node src/add-expense.ts",
    "migrate": "node src/migrate-store.ts",
    "backup": "node src/backup-store.ts",
    "synth": "node src/synth.ts",
    "export": "node src/export-store.ts",
    "import": "node src/import-store.ts",
    "check": "node src/check-repository.ts",
    "check:server": "node src/check-server.ts",
    "typecheck": "tsc -p .",
    "build": "node scripts/build.mjs",
    "pack": "node scripts/pack.mjs",
    "ci": "node scripts/ci.mjs",
    "load": "node scripts/load.mjs",
    "restore-drill": "node src/restore-drill.ts",
    "check:deploy": "node src/check-deploy.ts",
    "profile:top": "node scripts/top-self-time.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
