{
  "name": "js-learning-lab-wishlist-server",
  "version": "0.1.0",
  "private": true,
  "description": "The Node.js part of the wishlist: scripts and, later, the server",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test tests/*.test.ts",
    "summary": "node src/summary.ts",
    "acquire": "node src/acquire.ts",
    "migrate": "node src/migrate-store.ts",
    "backup": "node src/backup-store.ts",
    "check": "node src/check-repository.ts",
    "check:server": "node src/check-server.ts",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
