{
  "name": "js-learning-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first interactive course: JavaScript, React, React Native, Node.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "content:build": "node scripts/content/build.mjs",
    "content:validate": "node scripts/content/validate.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "pretest:e2e": "node scripts/build.mjs",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p app/tsconfig.json",
    "content:smoke": "node scripts/content/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.9",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "react-native-web": "^0.21.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "yaml": "^2.9.1"
  }
}
